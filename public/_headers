# Cloudflare (Workers static assets) — nagłówki.
# Domyślny Content-Type Cloudflare dla .txt/.xml to "text/plain" BEZ charset,
# a boty LLM czytają llms.txt/sitemap z polskimi znakami → wymuszamy utf-8.
# Po JEDNEJ regule na typ (nakładające się reguły dublowały nagłówek).
/*.txt
  Content-Type: text/plain; charset=utf-8
/*.xml
  Content-Type: application/xml; charset=utf-8
/*.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# Nagłówki bezpieczeństwa (wszystkie ścieżki).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
