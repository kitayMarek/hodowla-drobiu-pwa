# Cloudflare (Workers static assets) — nagłówki bezpieczeństwa.
# Content-Type/charset zostawiamy Cloudflare: .txt/.xml serwuje domyślnie jako
# utf-8 (własny override dublował nagłówek → "charset=utf-8, charset=utf-8").
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
