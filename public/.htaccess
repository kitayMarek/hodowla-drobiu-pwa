# Fermly – Apache SPA routing
Options -MultiViews
RewriteEngine On

# Przekierowanie HTTP → HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Nieistniejące pliki z rozszerzeniem (.js, .css, .json, .png…) → prawdziwe 404,
# zamiast soft-404 zwracającego index.html z kodem 200. Trasy aplikacji są
# bezrozszerzeniowe (/stada/123, /mleko/rhd), więc ta reguła ich nie dotyczy.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.[a-zA-Z0-9]{2,6}$ - [R=404,L]

# Nie przepisuj plików i katalogów które istnieją
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Wszystkie inne żądania → index.html (React Router)
RewriteRule ^ index.html [QSA,L]

# Kompresja gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# Cache dla statycznych assetów (Vite hashuje nazwy plików)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  # index.html i manifest – krótszy cache
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/manifest+json "access plus 1 hour"
</IfModule>

# Bezpieczeństwo
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Kodowanie znaków: wymuś UTF-8 w Content-Type (ważne dla botów LLM,
# np. llms.txt z polskimi znakami) oraz poprawny typ manifestu PWA.
AddDefaultCharset utf-8
<IfModule mod_headers.c>
  <FilesMatch "\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.xml$">
    Header set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.webmanifest$">
    Header set Content-Type "application/manifest+json; charset=utf-8"
  </FilesMatch>
</IfModule>
