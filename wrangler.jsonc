{
  // Cloudflare Workers (static assets) — hosting statycznej apki Fermly (Vite → dist).
  // Deploy: `npx wrangler deploy` wgrywa katalog dist jako statyczne assety.
  "name": "hodowla-drobiu-pwa",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    // Serwuj pliki .html DOKŁADNIE pod ich ścieżką (bez obcinania .html) —
    // statyczne mirrory GEO są zaindeksowane jako /x.html i mają self-canonical.
    // Domyślne "auto-trailing-slash" robiło 307 /faktura-vat-rr.html → /faktura-vat-rr.
    "html_handling": "none",
    // Routing SPA: nieistniejąca ścieżka (/vat-rr, /mleko/rhd) → index.html.
    // Istniejące pliki (assety, mirrory *.html, llms.txt) serwowane są wcześniej.
    "not_found_handling": "single-page-application"
  }
}
